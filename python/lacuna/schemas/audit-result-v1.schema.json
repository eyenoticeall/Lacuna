{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lacuna.dev/schemas/audit-result-v1.schema.json",
  "title": "Lacuna audit result v1",
  "description": "Canonical JSON envelope for Lacuna analysis and audit evidence, introduced in v0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "metrics",
    "findings",
    "tables",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "metrics": {
      "$ref": "#/$defs/jsonObject"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "tables": {
      "$ref": "#/$defs/jsonObject"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "method_version",
        "parameters",
        "seed",
        "input_fingerprint",
        "created_at"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "integer",
          "minimum": 1
        },
        "parameters": {
          "$ref": "#/$defs/jsonObject"
        },
        "seed": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "input_fingerprint": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "message",
        "state",
        "severity",
        "category",
        "evidence"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    }
  }
}
