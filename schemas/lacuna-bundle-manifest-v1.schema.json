{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lacuna.dev/schemas/lacuna-bundle-manifest-v1.schema.json",
  "title": "Lacuna reproducibility bundle manifest v1",
  "description": "Canonical manifest for a non-executable, checksummed Lacuna evidence bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_set_sha256",
    "artifacts",
    "bundle_version",
    "format",
    "producer",
    "report",
    "reproducibility",
    "security"
  ],
  "properties": {
    "artifact_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "bundle_version": {
      "const": 1
    },
    "format": {
      "const": "lacuna.reproducibility-bundle"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "lacuna"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_fingerprint",
        "method",
        "method_version",
        "path",
        "schema_version"
      ],
      "properties": {
        "input_fingerprint": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "const": "report/audit.json"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "scope", "verified"],
      "properties": {
        "level": {
          "const": "identifiable"
        },
        "scope": {
          "const": "artifact identity and archive integrity"
        },
        "verified": {
          "const": true
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_paths",
        "credentials",
        "executable_code",
        "plugins_activated",
        "source_data"
      ],
      "properties": {
        "absolute_paths": {
          "const": "redacted_or_rejected"
        },
        "credentials": {
          "const": "redacted_or_rejected"
        },
        "executable_code": {
          "const": false
        },
        "plugins_activated": {
          "const": false
        },
        "source_data": {
          "const": "not_included_automatically"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "path", "role", "sha256", "size"],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
        },
        "role": {
          "enum": [
            "canonical_report",
            "configuration",
            "environment",
            "evidence",
            "invocation",
            "provenance",
            "redaction_log",
            "rendered_report"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
